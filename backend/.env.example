# Local dev: copy to .env (kept out of git). In production, set these in the Railway/Render dashboard.

# Database (on Railway, reference the MySQL plugin variables, e.g. ${{MySQL.MYSQLHOST}})
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=share_management

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Server (Railway/Render inject $PORT; if unset we use SERVER_PORT)
SERVER_PORT=8080

# Deployment-only
# Comma-separated list of extra origins allowed by CORS (localhost origins are always allowed)
ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Public URL of THIS backend; used to build the ecommerce mini-app route
PUBLIC_BACKEND_URL=https://your-backend.up.railway.app
# Where uploaded files are stored on disk (Railway: attach a volume at /app/uploads)
UPLOAD_DIR=/app/uploads
# Where the ecommerce mini-app static files live on disk
MINI_APPS_DIR=/app/mini_apps/ecommerce
